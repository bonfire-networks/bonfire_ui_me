{#if @registered}
  {!-- no title: the success message has its own heading --}
  <Bonfire.UI.Me.AuthLayoutLive id="signup" page={:signup}>
    <div class="flex flex-col items-center text-center" id="signup_success_panel">
      <div class="text-3xl" aria-hidden="true">🎉</div>
      <h2 class="mt-4 type-page-title">{l("Hooray! You are registered")}</h2>
      <p class="mt-2 text-base leading-relaxed text-muted" id="signup_success">
        {#if @registered == :check_email}
          {l(
            "Now we need you to confirm your email address. We've emailed you a link (check your spam folder!). Please click on it to continue."
          )}
        {#else}
          {l("You can now log in.")}
        {/if}
      </p>
      <LinkLive class="mt-6 btn btn-primary" to={path(@home_page)}>
        {l("Back to home page")}
      </LinkLive>
    </div>
  </Bonfire.UI.Me.AuthLayoutLive>
{#else}
  <Bonfire.UI.Me.AuthLayoutLive id="signup" page={:signup} title={l("Sign up")}>
    <StatelessComponent
      :if={@instance_rules}
      module={maybe_component(Bonfire.CommunityRules.Web.InstanceRulesSummaryLive, @__context__)}
      sections={@instance_rules}
      class="mb-6 border-b border-base-content/15 pb-3"
    />

    <Bonfire.UI.Me.SignupFormLive
      form={@form}
      error={@error}
      invite={@invite}
      go={@go}
      auth_second_factor_secret={@auth_second_factor_secret}
      open_id_provider={@open_id_provider}
    />
  </Bonfire.UI.Me.AuthLayoutLive>
{/if}
