<div class="max-w-md w-full mx-auto mt-8 p-4">
  <Bonfire.UI.Common.LogoLinkLive
    with_name
    href="/"
    container_class="mb-8 flex justify-center items-center gap-4"
  />

  {#case @state}
    {#match :password}
      <h1 id="sudo-title" class="text-xl font-bold">{e(@description, :title, l("Confirm it's you"))}</h1>
      <p class="text-sm text-muted mt-1">{l("Confirm it's you to proceed")}</p>
      <div :if={@error} role="alert" class="alert alert-error mt-4">{@error}</div>
      <.form
        for={@form}
        id="sudo-password-form"
        action={path(:sudo_verify_password)}
        method="post"
        class="mt-4"
      >
        <input type="hidden" name="for" value={@action}>
        <input type="hidden" name="go" value={@go}>
        <Bonfire.UI.Me.PasswordInputLive
          id="sudo-password-input"
          name="password"
          label={l("Your password")}
          error={not is_nil(@error)}
        />
        <button id="sudo-password-submit" type="submit" class="btn btn-primary w-full mt-4">{l("Verify and continue")}</button>
      </.form>
      <.form
        for={@form}
        id="sudo-reset-form"
        action={path(:sudo_verify_send_email)}
        method="post"
        class="mt-3"
      >
        <input type="hidden" name="for" value={@action}>
        <input type="hidden" name="go" value={@go}>
        <button id="sudo-reset-btn" type="submit" class="link link-primary text-sm">{l("Can't remember it? Email me a reset link")}</button>
      </.form>
    {#match :email}
      <h1 id="sudo-title" class="text-xl font-bold">{l("Check your email")}</h1>
      <p class="text-sm text-muted mt-2">{if @sent,
          do:
            l("We've emailed you a link. Open it to confirm and open the confirmation link to proceed."),
          else: l("A link was already sent to your email address. Open it to confirm it's you.")}</p>
      <.form
        for={@form}
        id="sudo-resend-form"
        action={path(:sudo_verify_send_email)}
        method="post"
        class="mt-4"
      >
        <input type="hidden" name="for" value={@action}>
        <input type="hidden" name="go" value={@go}>
        <button id="sudo-resend-btn" type="submit" class="btn btn-outline w-full">{l("Resend the email")}</button>
      </.form>
    {#match :confirm}
      <h1 id="sudo-title" class="text-xl font-bold">{e(@description, :title, nil)}</h1>
      <p class="prose prose-sm mt-3">{e(@description, :description, nil)}</p>
      <.form
        for={@form}
        id="sudo-confirm-form"
        action={path(:sudo_confirm_execute)}
        method="post"
        class="mt-6"
      >
        <input type="hidden" name="action" value={@action}>
        <input :if={@target} type="hidden" name="target" value={@target}>
        <input type="hidden" name="go" value={@go}>
        <button id="sudo-confirm-btn" type="submit" class="btn btn-error w-full">{l("Confirm")}</button>
      </.form>
      <a href="/" class="link text-sm mt-4 inline-block">{l("Go to homepage")}</a>
    {#match _}
      <h1 id="sudo-title" class="text-xl font-bold">{e(@description, :title, nil)}</h1>
      <p class="prose prose-sm mt-3">{e(@description, :description, nil)}</p>
      <a href="/" class="link mt-4 inline-block">{l("Go to homepage")}</a>
  {/case}
</div>
