<Bonfire.UI.Me.AuthLayoutLive id="change-email" title={l("Change your email address")}>
  <Form for={@form || :change_email}>
    <p :if={@error}>{@error}</p>

    <div class="fieldset">
      <.input
        id="old_email"
        name="old_email"
        value={nil}
        type="email"
        label={l("Current email address")}
        label_class="fieldset-legend"
        class="w-full input"
      />
    </div>

    <div class="fieldset">
      <.input
        id="email"
        name="email"
        value={nil}
        type="email"
        autocomplete="none"
        label={l("New email address")}
        label_class="fieldset-legend"
        class="w-full input"
      />
    </div>

    <div class="mt-4">
      <button type="submit" phx-disable-with={l("Saving...")} class="w-full btn btn-primary">{l("Update email")}</button>
    </div>
  </Form>
</Bonfire.UI.Me.AuthLayoutLive>
