<Bonfire.UI.Common.LogoLinkLive
  with_name
  container_class="flex mt-16  items-center mb-8 justify-center gap-2"
  name_class="text-2xl font-bold tracking-wider"
  href="/"
/>
<div class="w-[90%] md:w-[360px] mx-auto p-3 rounded-xl border border-secondary bg-base-100 shadow-sm">
  <Form for={@form} id="change-password-form" action={path(Bonfire.UI.Me.ChangePasswordController)}>
    <div class="">
      <p>{@error}</p>

      <div class="">
        <div :if={!@resetting_password} class="mb-2 form-control">
          <Bonfire.UI.Me.PasswordInputLive
            id="old_password"
            name="old_password"
            label={l("Current password")}
          />
          <label class="label">
            <a href={path(:forgot_password)} class="text-xs link link-hovered">{l("Forgot password?")}</a>
          </label>
        </div>

        <Bonfire.UI.Me.PasswordInputLive
          id="password1"
          name="password"
          label={l("New password")}
          autocomplete="new-password"
        />

        <div class="mt-2">
          <Bonfire.UI.Me.PasswordInputLive
            id="password_confirmation"
            name="password_confirmation"
            label={l("Confirm new password")}
            autocomplete="new-password"
          />
        </div>
      </div>
      <div class="mt-3">
        <button type="submit" phx-disable-with={l("Saving...")} class="w-full btn btn-primary">{l("Submit")}</button>
      </div>
    </div>
  </Form>
</div>
