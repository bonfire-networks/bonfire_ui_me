<Bonfire.UI.Me.AuthLayoutLive id="confirm-link" title={@title}>
  {!-- submits on the first real human input, which scanners never send; key presses are left out so keyboard and screen reader users can reach the button --}
  <div
    data-role="confirm_link"
    x-data="{done: false, go() { if (this.done) return; this.done = true; $el.querySelector('form').requestSubmit() }}"
    x-on:pointerdown.window="go()"
    x-on:touchstart.window.passive="go()"
    x-on:wheel.window.passive="go()"
    x-on:mousemove.window="($event.movementX || $event.movementY) && go()"
  >
    <p :if={@intro} class="mb-4 text-sm text-muted">{@intro}</p>

    <.simple_form
      for={to_form(%{}, as: :confirm_link)}
      action={@action}
      class="w-full"
      opts={[id: "confirm-link-form"]}
    >
      <button class="w-full btn btn-primary" type="submit">{@button}</button>
    </.simple_form>
  </div>
</Bonfire.UI.Me.AuthLayoutLive>
