{#if @is_guest?}
  <Bonfire.UI.Common.GuestBoardLive page={:people}>
    <header class="px-4 pb-4 pt-6 sm:px-10">
      <h1
        data-role="page-title"
        class="type-page-title"
      >{@page_title}</h1>
    </header>
    <div id="guest-people" class="border-t border-base-content/10">
      <div
        :for={user <- @users}
        data-role="person-row"
        class="border-b border-base-content/10 px-4 py-4 last:border-b-0 sm:px-10"
      >
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Me.ProfileItemLive)}
          character={e(user, :character, nil) || e(user, :activity, :subject, :character, nil)}
          profile={e(user, :profile, nil) || e(user, :activity, :subject, :profile, nil)}
          is_remote={@is_remote}
          showing_within={:search}
          show_summary
          wrapper_class=""
          show_controls={[:follows_me, :follow]}
        />
      </div>
      <p :if={@users == []} class="px-4 py-6 text-muted sm:px-10">{l("No one to show here yet.")}</p>
    </div>

    <div :if={Bonfire.UI.Common.LoadMoreLive.end_cursor(@page_info)} class="border-t border-base-content/10 px-4 pb-6 sm:px-10">
      <Bonfire.UI.Common.LoadMoreLive live_handler={__MODULE__} page_info={@page_info} />
    </div>
  </Bonfire.UI.Common.GuestBoardLive>
{#else}
  <div class="grid mb-2 grid-cols-1 gap-4 max-w-[640px] mx-auto w-full divide-hair divide-divider bonfire-wrapper -mx-card">
    <div :for={user <- @users} class="pb-card">
      <StatelessComponent
        module={maybe_component(Bonfire.UI.Me.ProfileItemLive)}
        character={e(user, :character, nil) || e(user, :activity, :subject, :character, nil)}
        profile={e(user, :profile, nil) || e(user, :activity, :subject, :profile, nil)}
        is_remote={@is_remote}
        showing_within={:search}
        show_summary
        wrapper_class=""
        show_controls={[:follows_me, :follow]}
      />
      <!-- <Bonfire.UI.Me.UserPreviewLive user={user} /> -->
    </div>
  </div>

  <Bonfire.UI.Common.LoadMoreLive
    :if={@page_info}
    live_handler={__MODULE__}
    page_info={@page_info}
  />
{/if}
