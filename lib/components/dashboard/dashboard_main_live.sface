{!-- a widget's plain body (text, a button) takes the header's gutter; widgets with lists or carousels set their own --}
<div
  data-id="dashboard_main"
  data-widget-place
  class="**:data-[role=widget-body]:px-(--stream-content-padding)"
>
  <div
    :if={@editable}
    class="hidden widgets-editing:block px-5 pt-4 type-caption font-medium text-subtle"
  >{l("Main area")}</div>
  {#case List.wrap(@widgets)}
    {#match []}
      <div class="border border-secondary border-dashed rounded-xl p-4 flex flex-col gap-4 m-4 text-center text-base-content/80 flex items-center place-content-center flex-col">
        <div>{l("You can customise your dashboard by adding widgets here.")}</div>
        <LinkLive class="link link-primary flex items-center gap-2" to={~p"/settings/user/dashboard"}>
          <#Icon iconify="ph:gear-fill" class="w-5 h-5" />
          {l("Configure")}
        </LinkLive>
      </div>
    {#match widgets}
      {!-- the feed widget gets the requested feed and links its tabs to the dashboard --}
      <Bonfire.UI.Common.WidgetsLive
        widgets={widgets}
        page={@page}
        selected_tab={@selected_tab}
        showing_within={:main}
        container_class="flex flex-col widgets-editing:gap-3 widgets-editing:px-4 widgets-editing:pt-2"
        id="dashboard_main_widgets"
        reorderable={false}
        editable={@editable}
        with_title
        extra_data={%{
          requested_feed: @requested_feed,
          feed_tabs_path: &Bonfire.UI.Me.DashboardMainLive.feed_tab_path/1
        }}
      />
  {/case}
  <Bonfire.UI.Common.AddWidgetsLive :if={@editable} area={:main} addable={@addable} class="p-4" />
</div>
