<Bonfire.UI.Me.SettingsViewsLive.EditProfileInfoLive />

<StatelessComponent module={maybe_component(Bonfire.UI.Social.Graph.EditAliasesLive, @__context__)} />

<div class="p-4 border-t border-secondary">
  <div class="flex items-center gap-4 justify-between cursor-pointer">
    <div class="flex flex-col gap-1">
      <div class="text-error font-bold">{l("Delete User & Data")}</div>
      <div class="text-sm font-light text-muted">{l("Delete all the data associated with this user profile")}</div>
    </div>
  </div>
  <div>
    <div class="p-4 mt-4 mb-0 rounded-md bg-info/10">
      <div class="flex">
        <div class="flex-shrink-0">
          <#Icon solid="InformationCircle" class="w-5 h-5 text-info" />
        </div>
        <div class="flex-1 ml-3 md:justify-between">
          <div class="prose prose-sm text-info">
            <p>{l(
                "Deleting your user profile will remove all associated data from this server. This includes all posts, comments, and any other data associated with this user profile. It will also send requests to delete your data to other fediverse servers."
              )}</p>
            <p>{rich(
                l(
                  "Note: You can also delete [your entire account](/settings/account) and all associated users instead."
                )
              )}</p>
            <p>{l("This action cannot be undone.")}</p>
            <p>{l("You will verify your identity and confirm which profile to delete.")}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-3">
      <a
        id="verify-delete-profile"
        href={path(:sudo_confirm) <> "?" <> URI.encode_query(action: "Bonfire.Me.SensitiveActions.DeleteUser", target: current_user_id(@__context__))}
        class="btn-error btn mt-3 w-full"
      >
        {l("Continue to delete profile")}
      </a>
    </div>
  </div>
</div>
