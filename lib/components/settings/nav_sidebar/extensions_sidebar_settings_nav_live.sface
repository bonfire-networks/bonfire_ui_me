{#for {extension, modules} <- Bonfire.UI.Common.SettingsModule.app_modules()}
  {#case extension_enabled?(extension, @__context__) &&
      Bonfire.UI.Common.SettingsModule.nav(extension)}
    {#match false}
    {#match extension_nav}
      {#case {Enum.any?(
           Bonfire.UI.Common.SettingsModule.components(extension),
           &Bonfire.UI.Me.ExtensionSettingsLive.visible_in_scope?(&1, @scope)
         ),
         is_list(extension_nav) and extension_nav != [] and extension_nav != [true] and
           extension_nav != [false]}}
        {#match {has_settings_components?, has_settings_nav?}}
          {#if has_settings_components? or has_settings_nav?}
            {#case Bonfire.Common.ExtensionModule.extension(extension)}
              {#match extension_meta}
                <li>
                  <LinkLive
                    to={"/settings/#{@scope}/#{extension}"}
                    class={["!gap-4", "bg-primary/10": to_string(@selected_tab) == to_string(extension)]}
                  >
                    <#Icon iconify="ph:puzzle-piece-duotone" class="shrink-0 size-5 text-muted" />
                    <span class="font-normal text-base">{e(extension_meta, :name, nil) || extension}</span>
                  </LinkLive>
                </li>
            {/case}
          {/if}
      {/case}
  {/case}
{/for}