                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Custom emoji")}</span>
              </LinkPatchLive>
          {/case}
        </li>
        <li :if={module_enabled?(Bonfire.Me.SharedUsers, @__context__) &&
          Settings.get(:experimental_features_enabled, false,
            context: @__context__,
            name: l("Experimental Features"),
            description: l("Try features that work but are still being tested.")
          )}>
          {#case @selected_tab == "config_settings_registry"}
            {#match active}
              <LinkPatchLive
                to={~p"/settings/instance/config_settings_registry"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:gear-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Extra settings")}</span>
              </LinkPatchLive>
          {/case}
        </li>
        <li :if={Config.env() == :dev}>
          {#case @selected_tab == "icons"}
            {#match active}
              <LinkPatchLive
                to={~p"/settings/instance/icons"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:eye-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Icons")}</span>
              </LinkPatchLive>
          {/case}
        </li>
      </details>
    </li>
  </ul>
</div>
