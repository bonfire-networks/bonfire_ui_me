<div>
  <ul class="menu relative p-0 w-full gap-0 px-0 lg:px-5.5 mt-2">
    <li class="w-full mt-5 first:mt-0">
      <details open class="w-full overflow-hidden">
        <summary class="relative !pl-3 text-xs font-normal uppercase tracking-wide text-base-content hover:!bg-transparent">
          <span>{l("Instance")}</span>
        </summary>

        <li>
          {#case @selected_tab == "configuration" or @selected_tab in [nil, "instance_settings"]}
            {#match active}
              <LinkPatchLive
                to={~p"/settings/instance/configuration"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:gear-six-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("General Configuration")}</span>
              </LinkPatchLive>
          {/case}
        </li>
        <li>
          {#case @id == "behaviours"}
            {#match active}
              <LinkLive
                to={~p"/settings/instance/preferences/behaviours"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:sliders-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Default User Preferences")}</span>
              </LinkLive>
          {/case}
        </li>

        <li>
          {#case @selected_tab == "feeds"}
            {#match active}
              <LinkPatchLive
                to={~p"/settings/instance/feeds"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:rss-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Feed Defaults")}</span>
              </LinkPatchLive>
          {/case}
        </li>
        <li>
          {#case @selected_tab == "acl"}
            {#match active}
              <LinkLive
                to={~p"/settings/instance/boundaries/acl"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:lock-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Instance Permissions")}</span>
              </LinkLive>
          {/case}
        </li>
      </details>
    </li>

    <li class="w-full mt-5 first:mt-0">
      <details open class="w-full overflow-hidden">
        <summary class="relative !pl-3 text-xs font-normal uppercase tracking-wide text-base-content hover:!bg-transparent">
          <span>{l("Pages")}</span>
        </summary>

        <!-- <li>
          <LinkPatchLive
            to={~p"/settings/instance/dashboard"}
            class={["!gap-4", "bg-primary/10": @selected_tab == "dashboard"]}
          >
            <#Icon iconify="ph:house-duotone" class="shrink-0 size-5 text-muted" />
            <span class="font-normal text-base">{l("Dashboard")}</span>
          </LinkPatchLive>
        </li> -->
        <li>
