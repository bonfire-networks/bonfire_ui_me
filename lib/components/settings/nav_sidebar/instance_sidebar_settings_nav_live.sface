    <li class="w-full mt-5 first:mt-0">
      <details open class="w-full overflow-hidden">
        <summary class="relative !pl-3 text-xs font-normal uppercase tracking-wide text-base-content hover:!bg-transparent">
          <span>{l("Extensions")}</span>
        </summary>

        <li>
          {#case @selected_tab == "extensions"}
            {#match active}
              <LinkLive
                to={~p"/settings/instance/extensions"}
                class={[
                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:toggle-right-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
