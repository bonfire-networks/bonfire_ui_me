                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:sign-in-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Branding")}</span>
              </LinkPatchLive>
          {/case}
        </li>
      </details>
    </li>

    <li class="w-full mt-5 first:mt-0">
      <details open class="w-full overflow-hidden">
        <summary class="relative !pl-3 text-xs font-normal uppercase tracking-wide text-base-content hover:!bg-transparent">
          <span>{l("Members")}</span>
        </summary>

        <li>
