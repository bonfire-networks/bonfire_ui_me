                  "nav-row transition-colors duration-150",
                  Bonfire.UI.Common.LinkWidgetLive.active_link_class(active)
                ]}
                opts={if active, do: ["aria-current": "page"], else: []}
              >
                <#Icon iconify="ph:envelope-duotone" class={["shrink-0 size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(active)]} />
                <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(active)]}>{l("Invites")}</span>
