<div id="dashboard-settings" class="flex flex-col gap-4 py-4">
  <p class="text-sm px-4 leading-relaxed text-muted">{if @scope == :instance,
      do: l("The starting setup for members, who can change it for themselves."),
      else: l("Choose which widgets appear on your dashboard, and where.")}</p>

  <Bonfire.UI.Common.SettingsWidgetsLive
    place={Bonfire.Web.Views.DashboardLive}
    widgets={@widgets}
    scope={@scope}
  />
</div>
