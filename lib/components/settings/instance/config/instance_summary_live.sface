{#case community_defaults()}
  {#match defaults}
    <div id="community-expectations" class="min-w-0 text-base-content [overflow-wrap:anywhere]">
      {#case setting_rows(defaults)}
        {#match rows}
          {!-- a checkbox rather than JS, so it works on static guest pages --}
          <section id="community-settings" data-show-first aria-labelledby="community-settings-title">
            <input :if={length(rows) > 5} type="checkbox" id="community-settings-all" class="sr-only">
            <h2 id="community-settings-title" class="text-lg font-bold leading-snug tracking-[-0.01em]">{l("How this community works")}</h2>
            <ul data-role="settings-rows" class="mt-3">
              {#for row <- rows}
                <li class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] items-baseline gap-x-4 border-t border-base-content/10 py-2.5 text-base first:border-t-0 sm:grid-cols-[200px_minmax(0,1fr)]">
                  <span class="text-muted">{row.label}</span>
                  {#case row.value}
                    {#match :allowlist}
                      <div id={row.id} class="min-w-0 font-medium">
                        {#case instance_allowlist()}
                          {#match {[], _}}
                            <span>{l("No communities yet")}</span>
                          {#match {members, total}}
                            <ul id="community-allowlist" class="flex flex-wrap gap-1.5">
                              {#for member <- members}
                                {#case allowlist_entry(member)}
                                  {#match entry}
                                    <li class="min-w-0">
                                      <LinkLive
                                        to={entry.url}
                                        target="_blank"
                                        opts={[rel: "noopener noreferrer"]}
                                        class="inline-flex min-w-0 max-w-full items-center gap-1.5 rounded-full bg-base-content/6 py-1 pl-2 pr-3 text-sm font-medium hover:bg-base-content/10 focus-visible:outline-2 focus-visible:outline-offset-2"
                                      >
                                        <Bonfire.UI.Common.Icons.FaviconLive
                                          link={entry.favicon_for}
                                          icon={entry.icon}
                                          class="size-4 shrink-0"
                                        />
                                        <span class="min-w-0 truncate">{entry.label}</span>
                                      </LinkLive>
                                    </li>
                                {/case}
                              {/for}
                            </ul>
                            <span :if={total > length(members)} class="mt-1.5 block text-sm font-normal text-muted">{l("+%{count} more", count: total - length(members))}</span>
                        {/case}
                      </div>
                    {#match value}
                      <span id={row.id} class="min-w-0 font-medium">{value}</span>
                  {/case}
                </li>
              {/for}
            </ul>
            <label
              :if={length(rows) > 5}
              for="community-settings-all"
              data-role="show-all"
              class="mt-1 inline-flex min-h-11 cursor-pointer items-center text-sm font-medium underline decoration-divider underline-offset-3 hover:decoration-current"
            >
              <span data-when="closed">{l("Show all %{count} settings", count: length(rows))}</span>
              <span data-when="open">{l("Show fewer")}</span>
            </label>
          </section>
      {/case}

    </div>
{/case}
