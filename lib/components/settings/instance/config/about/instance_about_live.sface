<div class="flex flex-col gap-6 w-full">
  <form phx-submit="Bonfire.Common.Settings:save">
    <Bonfire.UI.Common.SettingsInputLive
      scope={:instance}
      input="ui[theme][instance_welcome][title]"
      name={l("Welcome Title")}
      keys={[:ui, :theme, :instance_welcome, :title]}
      default_value={Config.get([:ui, :theme, :instance_welcome, :title], nil,
        name: l("Welcome Title"),
        description: l("Title displayed on the welcome/about page.")
      )}
    />
  </form>

  <form phx-submit="Bonfire.Common.Settings:save">
    <Bonfire.UI.Common.SettingsTextareaLive
      scope={:instance}
      input="ui[theme][instance_welcome][description]"
      name={l("Welcome Description")}
      keys={[:ui, :theme, :instance_welcome, :description]}
      default_value={Config.get([:ui, :theme, :instance_welcome, :description], nil,
        name: l("Welcome Description"),
        description: l("Description text displayed on the welcome/about page.")
      )}
    />
  </form>

  <form phx-submit="Bonfire.Common.Settings:save">
    <Bonfire.UI.Common.SettingsInputLive
      scope={:instance}
      input="ui[theme][instance_welcome][invite_contact_email]"
      name={l("Contact email for invite requests")}
      description={l(
        "Shown on the signup page when this instance is invite-only. Leave blank to hide the request-an-invite button."
      )}
      placeholder="admin@example.org"
      keys={[:ui, :theme, :instance_welcome, :invite_contact_email]}
      default_value={Config.get([:ui, :theme, :instance_welcome, :invite_contact_email], nil,
        name: l("Contact email for invite requests"),
        description:
          l(
            "Shown on the signup page when this instance is invite-only. Leave blank to hide the request-an-invite button."
          )
      )}
    />
  </form>
  <StatefulComponent
    module={maybe_component(Bonfire.UI.Common.SettingsLinksEditorLive, @__context__)}
    id="instance_welcome_links_editor"
    scope={:instance}
    keys={[:ui, :theme, :instance_welcome, :links]}
    name={l("Community Links")}
    description={l("Links shown to visitors on the guest homepage (e.g., forum, chat, documentation).")}
  />

  {!-- the feedback widget and the getting-started checklist's wishes step both read these --}
  <div data-id="feedback_settings" class="flex flex-col gap-4">
    <div class="font-medium">{l("Feedback")}</div>
    <div class="text-sm text-muted">{l(
        "Ask people what they want of this place: link to a form, or, with no form, open the composer to post in a group or topic."
      )}</div>

    <form phx-submit="Bonfire.Common.Settings:save" class="flex flex-col gap-4">
      <Bonfire.UI.Common.SettingsInputLive
        scope={:instance}
        name={l("Title")}
        keys={[Bonfire.UI.Common.WidgetFeedbackLive, :title]}
        placeholder={l("Feedback")}
        submit_button={false}
      />
      <Bonfire.UI.Common.SettingsTextareaLive
        scope={:instance}
        name={l("Text")}
        keys={[Bonfire.UI.Common.WidgetFeedbackLive, :text]}
        placeholder={l("Help shape what comes next: what you say drives what gets built.")}
        submit_button={false}
      />
      <Bonfire.UI.Common.SettingsInputLive
        scope={:instance}
        name={l("Feedback form address (URL)")}
        description={l(
          "The web address of a form where people give their feedback, eg. a survey. The button opens it. Leave blank to have people post in a group or topic instead."
        )}
        keys={[Bonfire.UI.Common.WidgetFeedbackLive, :url]}
        placeholder="https://"
        submit_button={false}
      />
      <Bonfire.UI.Common.SettingsSelectLive
        scope={:instance}
        id="feedback_context_id"
        name={l("Group or topic to post in")}
        description={l(
          "Used when there is no form link. Only signed-in people can post, so guests don't see the widget then."
        )}
        label_name={l("Group or topic to post in")}
        keys={[Bonfire.UI.Common.WidgetFeedbackLive, :context_id]}
        options={Bonfire.UI.Common.WidgetFeedbackLive.context_options(@__context__)}
      />
      <Bonfire.UI.Common.SettingsTextareaLive
        scope={:instance}
        name={l("Text to start the post with")}
        keys={[Bonfire.UI.Common.WidgetFeedbackLive, :template]}
        submit_button={false}
      />
      <Bonfire.UI.Common.SettingsInputLive
        scope={:instance}
        name={l("Button text")}
        description={l("The words on the button, not where it goes.")}
        keys={[Bonfire.UI.Common.WidgetFeedbackLive, :cta_label]}
        placeholder={l("Share your wishes")}
        submit_button={false}
      />
      <button type="submit" class="btn btn-sm btn-soft btn-primary self-start">{l("Save")}</button>
    </form>
  </div>

  <div class="font-medium">{l("Components to include on the guest homepage")}</div>
  <form class="flex flex-col gap-4" phx-change="Bonfire.Common.Settings:set">
    <input name="scope" value={:instance} type="hidden">

    <Bonfire.UI.Common.SettingsToggleLive
      name={l("Show Spotlight")}
      description={l("Show posts pinned to this instance on the guest homepage (hidden when nothing is pinned)")}
      keys={[Bonfire.Web.Views.HomeLive, :include, :instance_pinned]}
      default_value
      scope={:instance}
      compact
    />

    <Bonfire.UI.Common.SettingsToggleLive
      name={l("Show public groups")}
      description={l(
        "Show a carousel of the groups visitors can see on the guest homepage (hidden when there are none)"
      )}
      keys={[Bonfire.Web.Views.HomeLive, :include, :groups]}
      default_value
      scope={:instance}
      compact
    />
  </form>

  <div class="font-medium">Components to include in the about page</div>
  <form class="flex flex-col gap-4" phx-change="Bonfire.Common.Settings:set">
    <input name="scope" value={:instance} type="hidden">

    <Bonfire.UI.Common.SettingsToggleLive
      name={l("Show users")}
      description={l("Show the users directory on the about page")}
      keys={[Bonfire.Web.Views.AboutLive, :include, :users]}
      default_value
      scope={:instance}
      compact
    />

    <Bonfire.UI.Common.SettingsToggleLive
      name={l("Show digital space defaults")}
      description={l("Show the digital space defaults on the about page")}
      keys={[Bonfire.Web.Views.AboutLive, :include, :preferences]}
      default_value
      scope={:instance}
      compact
    />
  </form>
</div>
