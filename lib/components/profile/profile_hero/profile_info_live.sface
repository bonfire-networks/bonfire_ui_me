<section>
  <div class={"flex flex-col", "mt-2": @character_type == :user, "mt-card": @character_type != :user}>
    <div
      :if={@character_type in [:user, :group] && e(@user, :profile, :summary, nil)}
      class={
        "w-full prose !text-base max-w-none",
        "mb-3 [&>p:first-child]:mt-0 [&>p:last-child]:mb-0": @character_type == :user,
        "mb-4": @character_type != :user
      }
    >
      {rich(e(@user, :profile, :summary, nil))}
    </div>

    <div :if={@familiar_followers != [] and current_user_id(@__context__) != id(@user)} class="mb-3">
      <Bonfire.UI.Me.FamiliarFollowersLive
        users={Enum.take(@familiar_followers, 3)}
        total={length(@familiar_followers)}
        size={:hero}
        parent_id="familiar-followers"
      />
    </div>

    <Bonfire.UI.Me.ProfileLinksLive
      user={@user}
      aliases={@aliases || []}
      joined_date={if @character_type == :user, do: Bonfire.Common.DatesTimes.date_from_pointer(@user)}
    />

    <Bonfire.UI.Me.ProfileStatsLive
      :if={@character_type == :user and Enum.any?([@post_count, @following_count, @followers_count])}
      user={@user}
      character_type={@character_type}
      post_count={@post_count}
      followers_count={@followers_count}
      following_count={@following_count}
    />
  </div>

  <#slot {@header} />

  <div :if={@character_type == :user} class="flex items-center w-full space-x-4">
    {#case Settings.get(:experimental_features_enabled, false, @__context__) &&
        (is_nil(current_user_id(@__context__)) or current_user_id(@__context__) == id(@user) or
           Bonfire.Social.Graph.graph_distance(current_user(@__context__), @user))}
      {#match false}
        <div />
      {#match true}
        <div />
      {#match nil}
        <progress title={l("Connection score unknown")} class="progress w-32" value="0" max="100" />
      {#match 0}
        <div />
      {#match distance when distance <= 1}
        <progress
          title={l("Connection score: %{distance}", distance: distance)}
          class="progress progress-success w-32"
          value="100"
          max="100"
        />
      {#match distance when distance <= 2}
        <progress
          title={l("Connection score: %{distance}", distance: distance)}
          class="progress progress-success w-32"
          value="80"
          max="100"
        />
      {#match distance when distance <= 3}
        <progress
          title={l("Connection score: %{distance}", distance: distance)}
          class="progress progress-info w-32"
          value="60"
          max="100"
        />
      {#match distance when distance <= 4}
        <progress
          title={l("Connection score: %{distance}", distance: distance)}
          class="progress progress-info w-32"
          value="40"
          max="100"
        />
      {#match distance when distance <= 5}
        <progress
          title={l("Connection score: %{distance}", distance: distance)}
          class="progress progress-warning w-32"
          value="20"
          max="100"
        />
      {#match distance when distance > 5}
        <progress
          title={l("Connection score: %{distance}", distance: distance)}
          class="progress progress-warning w-32"
          value="10"
          max="100"
        />
    {/case}
  </div>
</section>