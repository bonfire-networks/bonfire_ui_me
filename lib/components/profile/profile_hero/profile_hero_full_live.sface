<div>
  <section
    data-id="profile_hero"
    aria-label={l("Profile")}
    class="relative bg-base-100 border-0 border-b-(length:--divider-width) border-divider rounded-none shadow-none"
  >
    <!-- Sticky Header -->
    <div>
      {!-- TODO: put this logic in `update` fn instead? --}
      {#case {Media.avatar_url(@user), Media.banner_url(@user, fallback: false)}}
        {#match {avatar_url, banner_url}}
          {#case Media.maybe_dominant_color(@user, avatar_url, banner_url)}
            {#match color}
              {!-- {#if Settings.get([Bonfire.UI.Me.ProfileHeroFullLive, :background], false, @__context__) or
                @character_type != :user} --}
              <div
                data-id="hero_background"
                role="img"
                aria-label={l("Profile banner")}
                class="w-full relative h-37.5 aspect-auto bg-primary bg-center mt-0 mb-0 bg-cover bg-no-repeat"
                style={cond do
                  is_binary(color) -> "background-color: #{color}"
                  is_binary(banner_url) -> Bonfire.UI.Common.NextGenImageLive.background_image_set(banner_url)
                  true -> ""
                end}
              >
                <div :if={@back} class="absolute top-safe left-3 lg:top-3 z-50">
                  <Bonfire.UI.Common.BackButtonLive
                    back={@back}
                    type={@back_type}
                    icon="carbon:arrow-left"
                    icon_class="size-6"
                    class="btn btn-sm btn-circle z-50 border-0 bg-black/50 text-white shadow-none hover:bg-black/65"
                  />
                </div>
                <div
                  :if={@show_widgets_toggle && current_user_id(@__context__)}
                  class="absolute top-safe right-3 lg:top-3 z-50 xl:hidden"
                >
                  <label
                    for="widgets-drawer"
                    aria-label={l("Open widgets sidebar")}
                    class="btn btn-sm btn-circle border-0 bg-black/50 text-white shadow-none hover:bg-black/65"
                  >
                    <#Icon iconify="ph:sidebar-simple-fill" class="size-5" />
                  </label>
                </div>
                {!-- Hidden probe: if banner 404s, push refetch event via LiveView --}
                {#if is_binary(banner_url) && id(@user)}
                  <img
                    src={banner_url}
                    style="display:none;"
                    aria-hidden="true"
                    data-on-error={JS.push("Bonfire.Federate.ActivityPub:refetch_profile:#{id(@user)}")}
                    onerror="if(window.liveSocket&&this.dataset.onError)liveSocket.execJS(this,this.dataset.onError)"
                  />
                {/if}
                <div class="absolute right-3 bottom-3 flex gap-2">
                  <StatelessComponent
                    module={maybe_component(Bonfire.UI.Social.Graph.ProfileFollowIndicator, @__context__)}
                    user={@user}
                    follows_me={@follows_me}
                  />
                  <StatelessComponent
                    module={maybe_component(Bonfire.UI.Boundaries.ProfileBlockedIndicator, @__context__)}
                    object={@user}
                    user={@user}
                    is_local_user={@is_local?}
                    boundary_preset={@boundary_preset}
                    ghosted_instance_wide?={@ghosted_instance_wide?}
                    silenced_instance_wide?={@silenced_instance_wide?}
                    ghosted?={@ghosted?}
                    silenced?={@silenced?}
                  />
                </div>
              </div>

              <div data-id="hero_data" class="px-4">
                <div class="w-full flex flex-col sm:block">
                  <div class="contents sm:flex sm:flex-col lg:items-start sm:gap-4">
                    <div class="contents sm:flex sm:justify-between sm:items-center sm:w-full">
                      <div>
                        {#if !Settings.get([Bonfire.UI.Common.AvatarLive, :hide_avatars], false, @__context__)}
                          <Bonfire.UI.Common.AvatarLive
                            parent_id="profile-hero"
                            title={e(@user, :profile, :name, "Anon")}
                            class="inline-block object-cover size-24 md:mx-0 -mt-10 border-divider border-hair rounded-full"
                            user_id={id(@user)}
                            fallback_class="size-24"
                            src={avatar_url}
                            is_remote={!@is_local?}
                          />
                        {/if}
                      </div>

                      <div
                        class="flex items-center gap-3 order-last mt-1 w-full pb-4 sm:order-none sm:w-auto sm:pb-0"
                        data-id="profile_main_actions"
                      >
                        {#if current_user_id(@__context__) == id(@user)}
                          <LinkLive
                            to={~p"/settings/user/profile"}
                            class="btn btn-sm flex-1 sm:flex-none border border-divider bg-surface text-muted shadow-none hover:bg-fill-strong"
                          >
                            <#Icon iconify="ph:pencil-simple-duotone" class="size-4" />
                            <span>{l("Edit profile")}</span>
                          </LinkLive>
                        {/if}

                        {#if current_user_id(@__context__) != id(@user)}
                          {#if (@ghosted_instance_wide? == true && @silenced_instance_wide? == true) or
                              (@ghosted? == true && @silenced? == true)}
                            <button disabled class="font-medium flex-1 px-6 normal-case btn btn-disabled">
                              {l("Blocked")}
                            </button>
                          {#else}
                            {!-- the follow button sits beside the avatar, on its own full-width row at the end of the hero on mobile --}
                            <div data-role="follow_wrapper" class="flex-1 sm:flex-none">
                              <StatefulComponent
                                module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
                                id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, id(@user), __MODULE__)}
                                object_id={id(@user)}
                                object={@user}
                                follows_me={@follows_me}
                                path={path(@user)}
                                hide_icon
                                with_bell
                                class="btn btn-primary btn-sm flex-1 sm:flex-none"
                                class_already="btn btn-primary btn-soft btn-sm w-full sm:w-auto"
                                container_class="flex items-center gap-3 w-full"
                                bell_class="btn btn-sm btn-circle border border-divider bg-surface text-muted shadow-none hover:bg-fill-strong touch-target-expanded"
                                bell_class_enabled="btn btn-sm btn-circle border border-divider bg-surface text-primary shadow-none hover:bg-fill-strong touch-target-expanded"
                              />
                            </div>
                          {/if}

                          <StatelessComponent
                            :if={@character_type == :user and current_user_id(@__context__)}
                            module={maybe_component(Bonfire.UI.Boundaries.AddToCircleLive, @__context__)}
                            user_id={id(@user)}
                            parent_id="profile_hero"
                            as_icon
                            button_class="tooltip btn btn-sm btn-circle border border-divider bg-surface text-muted shadow-none hover:bg-fill-strong touch-target-expanded"
                          />
                        {/if}

                        <Bonfire.UI.Me.HeroMoreActionsLive
                          character_type={@character_type}
                          user={@user}
                          parent_id="profile_hero"
                          ghosted_instance_wide?={@ghosted_instance_wide?}
                          silenced_instance_wide?={@silenced_instance_wide?}
                          ghosted?={@ghosted?}
                          silenced?={@silenced?}
                          boundary_preset={@boundary_preset}
                          permalink={canonical_url(@user, preload_if_needed: false)}
                        />
                      </div>
                    </div>

                    <div class="flex flex-col flex-1 w-full mt-4 sm:mt-0">
                      <div class="flex justify-between">
                        <div class="flex flex-col flex-1 min-w-0 gap-1">
                          <div id="profile_name_section" class="type-result">
                            <LinkPatchLive class="text-2xl" to={~p"/@#{e(@user, :character, :username, nil)}"}>
                              {e(@user, :profile, :name, "Anonymous")}
                            </LinkPatchLive>
                            <span
                              :if={maybe_apply(Bonfire.Me.Accounts, :is_admin?, [@user], fallback_return: nil) == true}
                              data-role="admin"
                              title={l("This user is an instance administrator")}
                              class="ml-0.5 badge badge-xs uppercase font-normal text-sm badge-primary badge-outline"
                            >
                              {l("Admin")}
                            </span>
                            <span
                              :if={module_enabled?(Bonfire.Data.SharedUser, @__context__) && e(@user, :shared_user, :label, nil)}
                              class="badge badge-sm badge-primary uppercase badge-outline"
                            >
                              {e(@user, :shared_user, :label, nil)}
                            </span>
                          </div>

                          <div class="flex lg:items-center flex-col lg:flex-row gap-2 min-w-0">
                            <div class="flex flex-col gap-0 min-w-0">
                              <span
                                data-role="label"
                                phx-hook="Copy"
                                id={Bonfire.Me.Characters.display_username(@user, true)}
                                data-clipboard-text={Bonfire.Me.Characters.display_username(@user, true)}
                                title={l("Click to copy username")}
                                class="font-normal cursor-copy tooltip tooltip-right truncate text-base text-base-content"
                              >{Bonfire.Me.Characters.display_username(@user, true)}</span>
                              {!-- TODO: add widgets from config instead of hardcoded --}
                              <StatelessComponent
                                module={maybe_component(Bonfire.OpenScience.Orcid.AboutLive)}
                                user={@user}
                                aliases={@aliases || []}
                              />
                            </div>
                          </div>
                          {#if @character_type == :user}
                            {#case to_string(Bonfire.Common.Settings.get([:ui, :sidebar, :section_divider], "none", :instance))}
                              {#match "line"}
                                <div
                                  class="w-[260px] mt-2"
                                  style="border-top: 1px solid color-mix(in oklch, var(--color-base-content) 10%, transparent)"
                                  aria-hidden="true"
                                />
                              {#match "custom"}
                                {#case to_string(Bonfire.Common.Settings.get([:ui, :sidebar, :section_divider_image], "", :instance))}
                                  {#match src when src != ""}
                                    <div class="w-[260px] mt-2" aria-hidden="true">
                                      <img src={src} class="h-6 w-full object-contain" alt="">
                                    </div>
                                  {#match _}
                                {/case}
                              {#match _}
                            {/case}
                          {/if}
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="flex flex-col">
                    <Bonfire.UI.Me.ProfileInfoLive
                      ghosted_instance_wide?={@ghosted_instance_wide?}
                      silenced_instance_wide?={@silenced_instance_wide?}
                      ghosted?={@ghosted?}
                      silenced?={@silenced?}
                      character_type={@character_type}
                      boundary_preset={@boundary_preset}
                      user={@user}
                      path={@path}
                      is_local?={@is_local?}
                      selected_tab={@selected_tab}
                      aliases={@aliases}
                      post_count={e(assigns, :post_count, nil)}
                      followers_count={e(assigns, :followers_count, nil)}
                      following_count={e(assigns, :following_count, nil)}
                      familiar_followers={e(assigns, :familiar_followers, [])}
                    />
                  </div>

                  {!-- {#if @follows_me}
                  <p class="text-muted mt-3 text-sm">{"Follows you"}</p>
                {/if} --}
                </div>
              </div>
          {/case}
      {/case}
    </div>
  </section>
</div>
