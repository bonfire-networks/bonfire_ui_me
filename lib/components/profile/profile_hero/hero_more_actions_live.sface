<div
  :if={current_user_id(@__context__)}
  data-id={"hero_more_actions-#{@parent_id}"}
  class="flex items-center gap-3"
>
  <Dropdown
    id={"hero_more_actions_menu_#{@parent_id}"}
    position="bottom-end"
    trigger_class="btn btn-sm btn-circle border border-divider bg-surface text-muted shadow-none hover:bg-fill-strong touch-target-expanded"
    panel_class="dropdown_actions"
    label={l("More actions")}
    expanded_touch_target
  >
    <:trigger>
      <#Icon iconify="ph:dots-three-outline-vertical-fill" class="size-4" />
    </:trigger>

    <li :if={@permalink}>
      <a
        phx-hook="Copy"
        id={deterministic_dom_id(__MODULE__, id(@user), "hero_action_copy_url", @parent_id)}
        href={@permalink}
        target="_top"
        class="flex items-center gap-3 text-sm text-base-content"
      >
        <#Icon iconify="ph:copy-duotone" class="size-4 shrink-0 text-muted" />
        <span class="flex-1 truncate" data-role="label">{l("Copy link")}</span>
      </a>
    </li>
    <li>
      <StatelessComponent
        module={maybe_component(Bonfire.UI.Social.SubscribeFeedLive, @__context__)}
        feed_name={:user_activities}
        params={%{"username" => e(@user, :character, :username, nil)}}
        as_icon={false}
        parent_id={deterministic_dom_id(__MODULE__, id(@user), nil, @parent_id)}
      />
    </li>

    {#if @character_type == :user and extension_enabled?(:bonfire_ui_social_graph, @__context__)}
      <li role="separator" class="-mx-2 my-1 border-t border-divider" />
      <li>
        <LinkPatchLive
          class="flex items-center gap-3 text-sm text-base-content"
          to={~p"/@#{e(@user, :character, :username, nil)}/followed"}
        >
          <#Icon iconify="ph:users-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate">{l("Following")}</span>
          <span :if={e(@user, :following_count, nil)} class="text-muted tabular-nums">
            {e(@user, :following_count, 0)}
          </span>
        </LinkPatchLive>
      </li>
      <li>
        <LinkPatchLive
          class="flex items-center gap-3 text-sm text-base-content"
          to={~p"/@#{e(@user, :character, :username, nil)}/followers"}
        >
          <#Icon iconify="ph:users-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate">{l("Followers")}</span>
          <span :if={e(@user, :followers_count, nil)} class="text-muted tabular-nums">
            {e(@user, :followers_count, 0)}
          </span>
        </LinkPatchLive>
      </li>
    {/if}
    <li role="separator" class="-mx-2 my-1 border-t border-divider" />
    {#if current_user_id(@__context__) == id(@user)}
      <li>
        <LinkLive to="/settings" class="flex items-center gap-3 w-full text-sm text-base-content">
          <#Icon iconify="ph:gear-six-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate">{l("Settings")}</span>
        </LinkLive>
      </li>

      <li>
        <LinkLive to="/notifications" class="flex items-center gap-3 w-full text-sm text-base-content">
          <#Icon iconify="ph:bell-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate">{l("Notifications")}</span>
        </LinkLive>
      </li>

      <li :if={extension_enabled?(:bonfire_ui_messages, @__context__)}>
        <LinkLive to="/messages" class="flex items-center gap-3 w-full text-sm text-base-content">
          <#Icon iconify="ph:tray-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate">{l("Messages")}</span>
        </LinkLive>
      </li>
      <li>
        <LinkLive to={~p"/logout"} class="flex items-center gap-3 w-full text-sm text-base-content">
          <#Icon iconify="ph:sign-out-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate">{l("Logout")}</span>
        </LinkLive>
      </li>
    {#else}
      <li :if={extension_enabled?(:bonfire_ui_messages, @__context__) and @character_type == :user and
        maybe_apply(
          Bonfire.Federate.ActivityPub,
          :interaction_allowed?,
          [current_user(@__context__), @user],
          fallback_return: true
        )}>
        {#if current_user_id(@__context__)}
          <Bonfire.UI.Common.SmartInputButtonLive
            create_object_type={:message}
            prompt={l("Send a message")}
            icon_class="!size-4 text-muted"
            smart_input_opts={%{
              create_object_type: :message,
              recipients_editable: true,
              to_circles: [
                {id(@user), e(@user, :profile, :name, nil) || e(@user, :character, :username, l("someone"))}
              ]
            }}
            class="flex flex-row-reverse justify-end items-center gap-3 text-base-content"
          />
        {#else}
          <a
            href={Bonfire.UI.Me.RemoteInteractionLive.generate_url(
              "message",
              l("this user"),
              @permalink || URIs.canonical_url(@user),
              @__context__
            )}
            target="_top"
            class="flex items-center gap-3 text-sm text-base-content"
          >
            <#Icon iconify="ph:note-pencil-fill" class="size-4 shrink-0 text-muted" />
            <span class="flex-1 truncate">{l("Send a message")}</span>
          </a>
        {/if}
      </li>

      <li class="">
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Moderation.FlagActionLive, @__context__)}
          object={@user}
          permalink={@permalink}
          is_remote={not is_nil(e(@user, :character, :peered, nil))}
          parent_id={deterministic_dom_id(__MODULE__, id(@user), nil, @parent_id)}
          object_type={e(@user, :profile, :name, "this user")}
          class="flex items-center p-4 justify-between text-base-content"
        />
      </li>

      {#if !e(@user, :character, :peered, nil)}
        {#if @character_type == :user and
            maybe_apply(Bonfire.Me.Accounts, :is_admin?, [@__context__], fallback_return: nil) == true}
          {#if !maybe_apply(Bonfire.Me.Accounts, :is_admin?, [@user], fallback_return: nil) == true}
            <li class="">
              <Bonfire.UI.Common.OpenModalLive
                id={deterministic_dom_id(__MODULE__, id(@user), "make-admin", @parent_id)}
                title_text={l("Make this user an admin?")}
                form_opts={%{"phx-submit" => "Bonfire.Me.Users:make_admin"}}
              >
                <input type="hidden" name="username_or_id" value={id(@user)}>
                <p class="text-sm mb-3">
                  {l(
                    "SUPER POWERS: %{name} will be able to manage everything on this instance, including its settings and content. They'll also be sent flagged content to review and be able to act on it. This is a very powerful role, and should only be given to people you trust.",
                    name: Bonfire.Me.Characters.display_username(@user, true, true)
                  )}
                </p>

                <label class="label cursor-pointer justify-start gap-2">
                  <input type="checkbox" name="moderator" value="true" class="checkbox checkbox-sm">
                  <span class="label-text text-sm">{l("Also declare them as an instance moderator")}</span>
                </label>
                <p class="text-xs text-muted mt-1">
                  {l("Moderators are listed publicly on the instance's pages.")} {l("You can add/remove moderators without making them admins in the instance settings.")} {l(
                    "You can also give moderator powers to other users without declaring them as moderators, by configuring custom roles and circles."
                  )}
                </p>

                <:open_btn>
                  <div class="flex items-center gap-3 w-full text-sm text-base-content">
                    <#Icon iconify="ph:key-duotone" class="size-4 shrink-0 text-muted" />
                    <span class="flex-1 truncate">{l("Make admin")}</span>
                  </div>
                </:open_btn>

                <:action_btns>
                  <button class="btn btn-primary btn-sm">{l("Make them an admin")}</button>
                </:action_btns>
              </Bonfire.UI.Common.OpenModalLive>
            </li>
          {#else}
            <li class="">
              <Bonfire.UI.Common.OpenModalLive
                id={deterministic_dom_id(__MODULE__, id(@user), "revoke-admin", @parent_id)}
                title_text={l("Revoke their admin powers?")}
                form_opts={%{"phx-submit" => "Bonfire.Me.Users:revoke_admin"}}
              >
                <input type="hidden" name="username_or_id" value={id(@user)}>
                <p class="text-sm mb-3">
                  {l(
                    "%{name} will no longer be able to manage this instance, its users and its settings. They stay a moderator if they are one.",
                    name: Bonfire.Me.Characters.display_username(@user, true, true)
                  )}
                </p>

                <:open_btn>
                  <div class="flex items-center gap-3 w-full text-sm text-base-content">
                    <#Icon iconify="ph:key-duotone" class="size-4 shrink-0 text-muted" />
                    <span class="flex-1 truncate text-error">{l("Revoke admin")}</span>
                  </div>
                </:open_btn>

                <:action_btns>
                  <button class="btn btn-error btn-sm">{l("Revoke their admin powers")}</button>
                </:action_btns>
              </Bonfire.UI.Common.OpenModalLive>
            </li>
          {/if}
        {/if}
      {#else}
        <li>
          <button
            type="button"
            phx-click="Bonfire.Me.Users:fetch_outbox"
            phx-value-id={id(@user)}
            phx-value-canonical_uri={@permalink}
            class="flex items-center gap-3 w-full text-sm text-base-content"
          >
            <#Icon iconify="ph:sort-ascending-duotone" class="size-4 shrink-0 text-muted" />
            <span class="flex-1 truncate">{l("Get latest activities")}</span>
          </button>
        </li>
        <li>
          <a
            href={@permalink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 w-full text-sm text-base-content"
          >
            <#Icon iconify="ph:arrow-square-out-duotone" class="size-4 shrink-0 text-muted" />
            <span class="flex-1 truncate">{l("View remotely")}</span>
          </a>
        </li>
      {/if}

      {!-- TODO: pass the silenced/ghosted/blocked booleans so it isn't re-queried by BlockButtonLive --}
      <StatelessComponent
        module={maybe_component(Bonfire.UI.Boundaries.BlockMenuButtonsLive, @__context__)}
        parent_id={deterministic_dom_id(__MODULE__, id(@user), nil, @parent_id)}
        object={@user}
        with_icon
        permalink={@permalink}
      />
    {/if}
  </Dropdown>
</div>
