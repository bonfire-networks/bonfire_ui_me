<div id={@id} :hook phx-target={@myself} data-role="profile_hover_card">
  {!-- the hook shows, positions and marks it loading; ignore_attributes keeps that across patches. A named group, so `group-hover` inside still means the hovered link --}
  <div
    id={"#{@id}_panel"}
    data-role="profile_hover_card_panel"
    role="group"
    aria-label={e(@user, :profile, :name, nil)}
    class="group/hovercard fixed top-0 left-0 z-max w-80 rounded-box shadow-(--elevation-popover)"
    style="display: none"
    phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["style", "data-loading"])}
  >
    <.skeleton class="group-data-[loading]/hovercard:flex rounded-box border border-base-content/10 bg-base-100" />

    <div
      :if={@user && @presentation == :panel}
      class="group-data-[loading]/hovercard:hidden transition-opacity duration-150 ease-out starting:opacity-0"
    >
      <Bonfire.UI.Me.ProfileHoverCardBodyLive
        user={@user}
        extras={@extras}
        parent_id="profile_hover_card"
      />
    </div>
  </div>

  {!-- the tap's bottom sheet: the hook opens it with the skeleton and the same load fills it. Its own container because it's modal and the hover card isn't --}
  <dialog
    id={"#{@id}_sheet"}
    data-role="profile_hover_card_sheet"
    class="group/hoversheet modal modal-bottom motion-modal motion-sheet"
    aria-label={e(@user, :profile, :name, nil)}
    tabindex="-1"
    phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["open", "data-loading"])}
  >
    {!-- no bottom safe area: the sticky Follow bar carries it --}
    <div class="modal-box !p-0 max-h-[85dvh] overflow-y-auto">
      <.skeleton class="group-data-[loading]/hoversheet:flex" sheet />

      {!-- `starting:` (@starting-style) fades it in when the loading flag lifts --}
      <div
        :if={@user && @presentation == :sheet}
        class="group-data-[loading]/hoversheet:hidden transition-opacity duration-150 ease-out starting:opacity-0"
      >
        <Bonfire.UI.Me.ProfileHoverCardBodyLive
          user={@user}
          extras={@extras}
          sheet
          parent_id="profile_hover_sheet"
        />
      </div>

      {!-- after the body; once filled the hook focuses the dialog, so a screen reader starts on the person --}
      <form method="dialog">
        <button
          class="btn btn-sm btn-circle btn-ghost absolute top-2 right-2 z-3"
          aria-label={l("Close")}
        >
          <#Icon iconify="ph:x" class="size-4" />
        </button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>{l("Close")}</button>
    </form>
  </dialog>
</div>
