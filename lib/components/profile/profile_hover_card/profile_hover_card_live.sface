<div id={@id} :hook phx-target={@myself} data-role="profile_hover_card">
  {!-- shown, positioned and marked loading by the hook; ignore_attributes keeps those across LiveView patches. A named group, so `group-hover` inside the card (e.g. the counts) still means hovering that link, not the whole card --}
  <div
    id={"#{@id}_panel"}
    data-role="profile_hover_card_panel"
    role="group"
    aria-label={e(@card, :user, :profile, :name, nil)}
    class="group/hovercard fixed top-0 left-0 z-max w-80 rounded-box shadow-(--elevation-popover)"
    style="display: none"
    phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["style", "data-loading"])}
  >
    <div
      data-role="profile_hover_card_skeleton"
      aria-hidden="true"
      class="hidden group-data-[loading]/hovercard:flex flex-col gap-3 p-4 rounded-box border border-base-content/10 bg-base-100"
    >
      <div class="flex items-center gap-3">
        <div class="skeleton size-12 shrink-0 rounded-full" />
        <div class="flex flex-col gap-2">
          <div class="skeleton h-4 w-32" />
          <div class="skeleton h-3 w-24" />
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <div class="skeleton h-3 w-full" />
        <div class="skeleton h-3 w-2/3" />
      </div>
      <div class="skeleton mt-1 h-8 w-full rounded-full" />
    </div>

    <div :if={@card} class="group-data-[loading]/hovercard:hidden">
      <Bonfire.UI.Me.ProfileHoverCardBodyLive card={@card} parent_id="profile_hover_card" />
    </div>
  </div>
</div>
