<div class="w-full p-4 lg:p-0 mx-auto">
  {!-- SSO providers show in both modes (passwordless and password), so they don't vanish when passwordless is on --}
  <StatelessComponent
    module={maybe_component(Bonfire.OpenID.Web.SignInWithExternalProvidersLive)}
    source={:login}
  />
  {#if @passwordless_only? and @sso_first?}
    {!-- sign-in services lead; the email login stays one click away, the escape hatch if a service is down --}
    <details class="mt-4" data-role="email_login" open={login_error?(@error, @form)}>
      <summary class="text-sm link link-primary cursor-pointer">{l("Use email instead")}</summary>
      <div class="mt-3">
        <Bonfire.UI.Me.LoginEmailFormLive
          form={@form}
          error={@error}
          go={@go}
          external_signup_url={@external_signup_url}
          gated_login_message={@gated_login_message}
        />
      </div>
    </details>
  {#elseif @passwordless_only?}
    <Bonfire.UI.Me.LoginEmailFormLive
      form={@form}
      error={@error}
      go={@go}
      external_signup_url={@external_signup_url}
      gated_login_message={@gated_login_message}
    />
  {#else}
    <.simple_form
      for={@form}
      action={path(:login, :create)}
      class="w-full md:ml-0"
      opts={[id: "login-form"]}
    >
      <input
        type="hidden"
        name="go"
        value={@go || e(@form, :params, :go, nil) || e(@form, :source, :changes, :go, nil)}
      />
      {!-- <%= hidden_input f, :go %> --}

      {!-- <%= f = form_for @form, path(:login, :create), class: "w-full md:ml-0" %> --}

      <Bonfire.UI.Me.LoginErrorsLive form={@form} error={@error} />

      <div class="fieldset">
        <.input
          field={@form[:email_or_username]}
          required
          label={l("Email address or @username")}
          placeholder="alice@email.com"
          label_class="fieldset-legend"
          class="w-full input"
        />
      </div>

      <Bonfire.UI.Me.PasswordInputLive
        id="login-password-input"
        name="login_fields[password]"
        label={l("Password (Min 10 characters)")}
        placeholder={l("Type your password")}
      />
      {!-- <%= error_tag f, :password %> --}

      <LinkLive
        to={path(Bonfire.UI.Me.ForgotPasswordController)}
        class="block w-full my-3 text-sm capitalize link link-primary"
      >
        {l("Forgot password?")}</LinkLive>

      {!-- WIP: ADD A CONFIG TO ENABLE / DISABLE 2FA --}
      {!-- {#case Bonfire.Me.Accounts.SecondFactors.enabled?()}
      {#match true}
        <div class="mt-4 rounded-md shadow alert bg-base-content/10">
          <p class="mb-2">{l(
              "If you have two-factor authentication enabled, please enter the code provided by your app (optional)."
            )}</p>

          <Inputs for={:auth_second_factor}>
            <Field name={:code} class="flex flex-col mt-2">
              <TextInput class="w-full input input-bordered" />

            </Field>
          </Inputs>
        </div>
      {#match _}
    {/case} --}
      <.button
        id="login_submit_btn"
        type="submit"
        variant="primary"
        full_width
        loading_text={l("Logging in...")}
      >
        {l("Sign in")}
      </.button>

      <div :if={!Bonfire.Me.Accounts.instance_is_invite_only?()} class="mt-3">
        <div class="flex py-3 pb-2 mt-3 border-t border-secondary place-content-center">
          <LinkLive to={path(:signup)} class="text-sm text-center normal-case">
            {l("Don't have an account?")} <span class="link link-primary">{l("Sign up")}</span></LinkLive>
        </div>
      </div>
    </.simple_form>
  {/if}
</div>
