<div
  class="fieldset w-full"
  x-data={"{show: false, status: '', t: #{Jason.encode!(%{show: l("Show password"), hide: l("Hide password"), shown: l("Your password is visible"), hidden: l("Your password is hidden")})}}"}
  x-init="$el.closest('form')?.addEventListener('submit', () => { show = false; status = '' })"
  x-on:pageshow.window="show = false; status = ''"
>
  <label :if={@label} for={@id} class="fieldset-legend">{@label}</label>
  {!-- one composed `.input` field: the button sits after the <input> element (not overlaid on it), so password-manager icons land beside it rather than on top --}
  <div class={"w-full pe-1 input", "input-error": @error}>
    <input
      id={@id}
      name={@name}
      type="password"
      placeholder={@placeholder}
      x-bind:type="show ? 'text' : 'password'"
      autocomplete={@autocomplete}
      spellcheck="false"
      autocapitalize="none"
      autocorrect="off"
      required={@required}
      aria-invalid={to_string(@error)}
      class="flex-1 min-w-0"
    />
    {!-- both labels share one grid cell so the button keeps its width when toggling --}
    <button
      type="button"
      x-cloak
      aria-controls={@id}
      aria-label={l("Show password")}
      data-role="toggle_password_visibility"
      x-bind:aria-label="show ? t.hide : t.show"
      x-on:click="show = !show; status = show ? t.shown : t.hidden"
      class="grid justify-items-center shrink-0 btn btn-ghost btn-sm font-medium text-muted hover:text-base-content"
    >
      <span class="col-start-1 row-start-1" x-bind:class="{'invisible': show}" aria-hidden="true">{l("Show")}</span>
      <span class="col-start-1 row-start-1" x-bind:class="{'invisible': !show}" aria-hidden="true">{l("Hide")}</span>
    </button>
  </div>
  <span class="sr-only" aria-live="polite" x-text="status" />
</div>
