<label class="fieldset w-full" for={@id}>
  <legend :if={@label} class="fieldset-legend">{@label}</legend>
  <div class="w-full relative" x-data="{show: false}">
    <input
      id={@id}
      name={@name}
      type="password"
      placeholder={@placeholder}
      :type="show ? 'text' : 'password'"
      autocomplete={@autocomplete}
      required={@required}
      aria-invalid={to_string(@error)}
      class="w-full input"
    />
    <div
      x-show="show == false"
      x-on:click="show = true"
      class="absolute cursor-pointer top-1 right-2 btn btn-ghost btn-circle btn-sm"
    >
      <#Icon solid="EyeOff" class="w-4 h-4" />
    </div>
    <div
      x-show="show == true"
      x-on:click="show = false"
      class="absolute cursor-pointer top-1 right-2 btn btn-ghost btn-circle btn-sm"
    >
      <#Icon solid="Eye" class="w-3 h-3 text-primary" />
    </div>
  </div>
</label>
