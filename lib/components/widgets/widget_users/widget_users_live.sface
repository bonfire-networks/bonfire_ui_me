<Bonfire.UI.Common.WidgetBlockLive
  title_class="text-xs pt-card px-card uppercase tracking-wider text-base-content pb-card border-b-hair border-divider [.sidebar-widgets_&]:pt-0 [.sidebar-widgets_&]:px-0 [.sidebar-widgets_&]:border-b-0"
  widget_title={e(@widget_title, "Users")}
  class="widget-users"
>
  <:action>
    <div class="flex items-center ml-auto gap-2">
      {#if @with_batch_follow && current_user_id(@__context__)}
        <StatefulComponent
          module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
          id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, ids(@users), @parent_id)}
          object_ids={ids(@users)}
          my_follow={:skip}
          hide_text
          with_bell={false}
          container_class=""
          class="group btn btn-circle btn-xs btn-outline border-divider text-primary"
        />
      {/if}
      <#slot {@action} />
    </div>
  </:action>

  <div class="flex flex-col divide-hair divide-divider">
    {#for user <- @users}
      {!-- the lists shown here are cached for everyone, so whoever this viewer silenced is dropped here --}
      <StatefulComponent
        module={maybe_component(Bonfire.UI.Boundaries.IfCan, @__context__)}
        id={deterministic_dom_id(
          __MODULE__,
          id(e(user, :activity, :subject, nil) || user),
          "widget_users_if_can",
          @parent_id
        )}
        object={e(user, :activity, :subject, nil) || user}
        check_object_boundary={current_user_id(@__context__) && [:see]}
      >
        <div class="p-1 [.sidebar-widgets_&]:py-1 [.sidebar-widgets_&]:px-0" data-role="widget-user-row">
          <StatelessComponent
            module={maybe_component(Bonfire.UI.Me.ProfileItemLive)}
            show_controls={[]}
            with_popover
            parent_id={deterministic_dom_id(__MODULE__, id(e(user, :character, nil) || user), "widget_users", @parent_id)}
            character={e(user, :character, nil) || e(user, :activity, :subject, :character, nil)}
            profile={e(user, :profile, nil) || e(user, :activity, :subject, :profile, nil)}
            class="btn btn-square btn-ghost btn-sm"
            wrapper_class="widget-user-profile flex items-center justify-between gap-1 p-0 border-0 rounded-none bg-transparent"
            avatar_class="size-9 rounded-full"
            fallback_class="size-9 rounded-full"
          />
        </div>
      </StatefulComponent>
    {/for}
  </div>
  <div :if={slot_assigned?(:footer)} class="pt-3">
    <#slot {@footer} />
  </div>
</Bonfire.UI.Common.WidgetBlockLive>
