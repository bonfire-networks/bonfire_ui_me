{#case list_users()}
  {#match []}
    <div />
  {#match users}
    <Bonfire.UI.Me.WidgetUsersLive
      :if={Bonfire.UI.Common.GuestBoardLive.show_people?(@__context__)}
      widget_title={e(@widget_title, l("Recently joined"))}
      users={users}
      parent_id="widget_highlight_users"
    />
{/case}