{!-- only those the viewer may see, as the instance chose (`Bonfire.Me.Users.list_visible_moderators/1`) --}
{#case Bonfire.Me.Users.list_visible_moderators(@__context__)}
  {#match []}
  {#match mods}
    {#if @showing_within == :main}
      <div id="mods">
        <Bonfire.UI.Common.WidgetBlockLive
          widget_title={e(@widget_title, l("Moderators"))}
          class={@class}
          section
        >
          <Bonfire.UI.Me.UsersGridLive users={mods} parent_id="mod" item_role="mod-link">
            <:footer>
              <Bonfire.UI.Me.MessageModeratorsLive class="btn btn-outline border-base-content/15 mt-3 w-full normal-case gap-2" />
            </:footer>
          </Bonfire.UI.Me.UsersGridLive>
        </Bonfire.UI.Common.WidgetBlockLive>
      </div>
    {#else}
      <Bonfire.UI.Me.WidgetUsersLive
        widget_title={e(@widget_title, l("Moderators"))}
        users={mods}
        parent_id="widget_mods"
        reset_cache_event="Bonfire.UI.Me.WidgetModsLive:reset"
        can_reset={Bonfire.Boundaries.can?(@__context__, :assign, :instance_wide) == true}
      >
        <:footer>
          <Bonfire.UI.Me.MessageModeratorsLive class="btn btn-sm btn-outline border-base-content/15 normal-case gap-2 w-full" />
        </:footer>
      </Bonfire.UI.Me.WidgetUsersLive>
    {/if}
{/case}
