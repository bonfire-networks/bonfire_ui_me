{#case list_visible(@__context__)}
  {#match []}
    <div />
  {#match admins}
    <Bonfire.UI.Me.WidgetUsersLive
      widget_title={e(@widget_title, l("Admins"))}
      users={admins}
      parent_id="widget_admins"
    >
      <:action>
        {#if @show_reset_btn || Bonfire.Boundaries.can?(@__context__, :assign, :instance_wide)}
          <button
            :on-click="Bonfire.UI.Me.WidgetAdminsLive:reset"
            type="button"
            class="group btn btn-circle btn-xs touch-target-expanded btn-outline border-divider"
            title={l("Refresh")}
          >
            <span class="touch-target-hit-area" aria-hidden="true" />
            <span class="sr-only">{l("Refresh")}</span>
            <#Icon iconify="ph:arrow-counter-clockwise-duotone" class="w-4 h-4 text-primary" />
          </button>
        {/if}
      </:action>
    </Bonfire.UI.Me.WidgetUsersLive>
{/case}