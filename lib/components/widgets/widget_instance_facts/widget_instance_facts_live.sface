{#case if(is_nil(@is_guest?), do: is_nil(current_user_id(@__context__)), else: @is_guest?)}
  {#match guest?}
    <div id="community-glance">
      <Bonfire.UI.Common.WidgetBlockLive widget_title={l("At a glance")} class={@class} section>
        <Bonfire.UI.Me.InstanceFactsListLive is_guest?={guest?} />
      </Bonfire.UI.Common.WidgetBlockLive>
    </div>
{/case}
